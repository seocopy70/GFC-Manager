# Copy to /etc/gfc-manager/gfc-manager.env and fill values privately.
DATABASE_URL=postgresql://gfc_app:REPLACE_WITH_DB_PASSWORD@10.0.0.50:5432/gfc_manager_db
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ORIGIN=https://REPLACE_WITH_GFC_HOSTNAME
SESSION_COOKIE_NAME=gfc_session
SESSION_DAYS=30
COOKIE_SECURE=true

# Required to enable public signup; keep this secret out of Git.
INVITE_CODE=REPLACE_WITH_PRIVATE_INVITE_CODE
